<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      链节点 RPC(26657) / REST(1317) 默认以明文 HTTP 暴露，且端点由用户在设置页自行填写；
      Android 的 <domain> 不支持网段通配，无法只放行任意局域网 IP，因此允许明文流量。
      生产环境请优先填写 HTTPS 端点；本配置仅保证节点自建/内网场景可用。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
