# MC 公链 · 链下 attestation 签名服务（oraclesvc，`mcchaind oracle`）环境变量
# ============================================================================
# 用法：
#   sudo install -m 600 -o mcchain-oracle -g mcchain-oracle \
#        deploy/oracle-signer.env.example /etc/mcchain/oracle-signer.env
#
# 定位（重要，避免装错服务）：
#   本服务 = internal/oraclesvc（`mcchaind oracle`）—— 主网**唯一**认证签名服务。
#   它具备 /sign 的 Bearer 鉴权、TLS、按 IP 限流、attestation 根校验（Play Integrity /
#   Huawei / Android Key Attestation 证书链）与健康自检。
#   仓库里另一个 cmd/oracle（独立二进制 mc-oracle）是**开发/CI 工具**：它的
#   ORACLE_VERIFIER 闸门在 strict 模式下一律拒绝启动（tee 未接线、soft 不允许），
#   因此**不能**用于主网。不要把它装到生产机上。
#
# 严格模式（ORACLE_STRICT=1 或 ORACLE_ENV=production）下，下列标 [S] 的项缺一即拒绝启动。

# ── 基本拓扑 ───────────────────────────────────────────────────────────────
# [必填] 监听地址 host:port。**必须显式设置** —— 留空时 net/http 会静默监听 :80。
# 生产建议只绑内网/回环，由 Nginx 终止 TLS 并转发。
ORACLE_LISTEN=127.0.0.1:8080
# [S] 严格（生产）模式。开启后强制校验本文件里所有 [S] 项。
ORACLE_STRICT=1

# ── 鉴权与传输安全 ─────────────────────────────────────────────────────────
# [S] /sign 的 Bearer token。缺失 = 任何人都能拿到预言机签名。
# 生成：openssl rand -hex 32
ORACLE_SIGN_TOKEN=
# [S] TLS 证书/私钥（必须成对出现；只配一个会被拒绝，不会静默降级成明文）。
# 若置于 TLS 反向代理之后，可改为显式豁免：
# ORACLE_TLS_CERT=/etc/mcchain/tls/oracle.crt
# ORACLE_TLS_KEY=/etc/mcchain/tls/oracle.key
ORACLE_ALLOW_PLAINTEXT=1
# [S] /sign 每分钟每 IP 请求上限（0 = 不限流；非法值会报错而不是静默变 0）
ORACLE_RATE_LIMIT=120

# ── [S] attestation 根（至少配一个，否则 /sign 恒久 fail-closed = 服务不可用）──
# 可选根名（ORACLE_ACCEPT_ROOTS 逗号分隔）：play_integrity, huawei, android_key_attestation
# 不设 ORACLE_ACCEPT_ROOTS = 接受全部已配置的根。
ORACLE_ACCEPT_ROOTS=play_integrity,android_key_attestation
# Google Play Integrity 根公钥（PEM，ES256）
ORACLE_GOOGLE_PUBKEY_FILE=/etc/mcchain/roots/play_integrity.pem
# 华为根公钥（PEM，ES256）
# ORACLE_HW_PUBKEY_FILE=/etc/mcchain/roots/huawei.pem
# Android Key Attestation 可信根 CA（PEM 包）
ORACLE_ANDROID_ROOTS_FILE=/etc/mcchain/roots/android_key_attestation.pem

# ── 健康自检 ───────────────────────────────────────────────────────────────
# 自检周期（默认 60s）与「多久没有成功签名即视为降级」（默认 10m）
ORACLE_HEALTH_INTERVAL=60s
ORACLE_HEALTH_STALE=10m

# ── 签名密钥（放在 /etc/mcchain/oracle-signer.key.env，与上面分离）──────────
# [S] 固定签名密钥：32 字节 hex（或 hex seed）。**必须固定** —— 每次重启换密钥会让
# 链上 MC_ORACLE_PUBKEY 立刻失配，设备 attestation 全部验签失败。
# 生成：openssl rand -hex 32
#   ORACLE_KEY=<64 hex chars>
# 或用文件：ORACLE_KEY_FILE=/etc/mcchain/oracle.key（chmod 600）
# [可选] keyring 目录（默认 $HOME/.mcchain-oracle）
#   ORACLE_KEYRING_DIR=/var/lib/mcchain-oracle/.mcchain-oracle

# ── 与节点节点的联动 ───────────────────────────────────────────────────────
# 起服务后 curl http://127.0.0.1:8080/pubkey 取 pubkey_base64，
# 填进节点（deploy/mainnet.env.example）的 MC_ORACLE_PUBKEY。
